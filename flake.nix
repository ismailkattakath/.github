# ismailkattakath's owner-wide defaults: GitHub serves the community health files under
# .github/ to every public ismailkattakath repo that has no copy of its own. Every file but
# this flake and the README is generated by repo-kit (kattakath/nix-config ADR-016), which
# holds the ONE text both owners' `.github` repos share: change it there, not here.
{
  description = "Default community health files for ismailkattakath's public repositories";

  inputs = {
    repo-kit.url = "github:ismailkattakath/repo-kit";
    nixpkgs.follows = "repo-kit/nixpkgs";
    flake-parts.follows = "repo-kit/flake-parts";
  };

  outputs =
    inputs@{ flake-parts, repo-kit, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      imports = [ repo-kit.flakeModules.default ];

      repoKit = {
        name = ".github";
        license = {
          spdx = "MIT";
          year = "2026";
          holder = "Ismail Kattakath";
        };
        community = {
          enable = true;
          owner = "ismailkattakath";
          conductContact = "ismail@kattakath.com";
        };
      };

      perSystem =
        { pkgs, ... }:
        {
          repoKit = {
            devPackages = [
              pkgs.git
              pkgs.gh
            ];
            requiredBins = [
              "git"
              "gh"
            ];
          };
        };
    };
}
